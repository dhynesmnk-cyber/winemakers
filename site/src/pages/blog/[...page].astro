---
/**
 * `/blog/` and `/blog/page/[n]/` — the journal index. UX.md §2.4, DESIGN.md §505.
 *
 * Called **Journal** in the interface and `/blog/` in the URL. DESIGN.md §193
 * and §219 name it Journal in the corner menu and the footer; TRD.md §4.2's
 * route table gives the path. The reader sees the word, the URL is an
 * identifier, and neither has to move for the other.
 *
 * NOT built on `TaxonomyPage`, deliberately. That component's whole subject is a
 * producer listing — its count line says "36 producers", its rows are
 * `ProducerEntry`, its `ItemList` is `producerItems`. Passing posts through it
 * would mean parameterising every one of those, which is how one shell becomes
 * two shells wearing one name. The pieces that genuinely are shared — the
 * breadcrumb, the section opener, the hairline entry list, the pager — are
 * shared as themselves.
 *
 * Like `/producers/`, this is NOT present-only: there is no taxonomy to be
 * present in, and it exists at zero posts. A journal that 404s itself before its
 * first post would break the footer link on every page of the site.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Pager from "../../components/Pager.astro";
import PostEntry from "../../components/PostEntry.astro";
import { itemList, postItems } from "../../data/jsonld.ts";
import { POSTS_PER_PAGE, allPosts, type Post } from "../../data/posts.ts";
import { pageHref, rootCrumbs, type Paged } from "../../data/taxonomy.ts";

export async function getStaticPaths() {
  const posts = await allPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

  return [
    { params: { page: undefined }, props: { posts, n: 1 } },
    ...Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((n) => ({
      params: { page: `page/${n}` },
      props: { posts, n },
    })),
  ];
}

interface Props {
  posts: Post[];
  n: number;
}

const { posts, n } = Astro.props;

const base = "/blog/";
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const start = (n - 1) * POSTS_PER_PAGE;
const items = posts.slice(start, start + POSTS_PER_PAGE);

/*
  `Paged` is typed around `Producer[]`, so `items` is filled with the slice this
  page renders and `Pager` reads only the counts and hrefs. Rather than widen
  the shared type for one caller, the one field that would lie is left as the
  cast it is, with the reason written down: `Pager.astro` touches
  `current`, `totalPages`, `prev`, `next`, `links` and `showPager` and nothing
  else.
*/
const paged = {
  items: items as unknown as Paged["items"],
  current: n,
  totalPages,
  totalItems: posts.length,
  base,
  prev: n > 1 ? pageHref(base, n - 1) : null,
  next: n < totalPages ? pageHref(base, n + 1) : null,
  links: Array.from({ length: totalPages }, (_, i) => ({
    n: i + 1,
    href: pageHref(base, i + 1),
    current: i + 1 === n,
  })),
  showPager: totalPages > 1,
} satisfies Paged;

const title = "The journal";
const description =
  "Writing about independent Australian wine: who owns what, how the " +
  "register works, and what this guide can and cannot show.";

const pageTitle = n > 1 ? `${title}, page ${n}` : title;

const countLine =
  posts.length === 0
    ? "No posts yet"
    : posts.length === 1
      ? "1 post"
      : `${posts.length} posts`;

const structuredList = itemList({
  name: title,
  description,
  items: postItems(items),
  totalItems: posts.length,
  startPosition: start + 1,
});
---

<BaseLayout title={pageTitle} description={description} jsonld={[structuredList]}>
  <Fragment slot="head">
    {paged.prev && <link rel="prev" href={new URL(paged.prev, Astro.url).href} />}
    {paged.next && <link rel="next" href={new URL(paged.next, Astro.url).href} />}
  </Fragment>

  <div class="reading-spine">
    <Breadcrumbs crumbs={rootCrumbs("Journal")} />

    <header class="journal-head">
      <h1 class="journal-head__title">{title}</h1>
      <p class="journal-head__count mono mono-caps">{countLine}</p>
    </header>

    <p class="journal-note">
      Posts are written from published sources and checked against them before
      they go up. Every one lists what it was written from, and figures come from
      the guide's own data rather than being typed in.
    </p>

    <section class="section-gap">
      <p class="section-opener draw-line">Posts</p>

      {
        posts.length === 0 ? (
          <p class="journal-empty">
            Nothing here yet. The <a href="/methodology/">methodology page</a>{" "}
            states how this guide decides what counts as independent, which is
            what most of the writing here will be about.
          </p>
        ) : (
          <ul class="entry-list">
            {items.map((post) => (
              <PostEntry post={post} />
            ))}
          </ul>
        )
      }

      <Pager paged={paged} />
    </section>
  </div>
</BaseLayout>

<style>
  .journal-head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .journal-head__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin: 0 0 0.5rem;
  }

  .journal-head__count {
    color: var(--ink-faded);
    margin: 0;
  }

  .journal-note,
  .journal-empty {
    max-width: 60ch;
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .journal-empty {
    font-style: italic;
    color: var(--ink-faded);
  }
</style>
