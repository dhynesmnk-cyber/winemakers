---
/**
 * ProducerEntry.astro — one row in a producer list. DESIGN.md §5.
 *
 * NO CARDS. This is a typographic entry, like a line in a table of contents:
 * name in the display face, a mono dateline, a one-line summary in italic, and
 * a present-only fact row. Separated from its neighbours by a hairline and
 * nothing else.
 *
 * No boxes, no fills, no shadows, no hover-lift, no border, no background.
 * This is the single rule most likely to be violated by muscle memory, and the
 * one that most determines whether the site passes DESIGN.md §10.
 *
 * ONE narrow exception, inherited from the reference: where a producer has a
 * published photograph, a small unbordered, unrotated thumbnail may sit beside
 * the text — no mount, no shadow, no change to the hairline rhythm. It exists
 * solely to give the list→detail photo transition a shared element. Producers
 * with no image show nothing extra. This is not a general reintroduction of
 * thumbnails.
 */
import FactRow from "./FactRow.astro";
import { CATEGORY_LABELS, STATE_NAMES } from "../config.ts";
import { regionName } from "../data/regions.ts";

interface Props {
  slug: string;
  data: Record<string, any>;
}

const { slug, data } = Astro.props;

// Dateline: suburb, state, primary region, category. Words, not codes.
//
// A suburb that repeats the region name is dropped rather than printed twice.
// The town of McLaren Vale sits inside the McLaren Vale region, so the naive
// join reads "McLaren Vale · South Australia · McLaren Vale", which a reader
// takes for a rendering fault rather than for a locality. Compared on the
// rendered names, because that is what is actually shown; slugs would miss a
// register entry whose name and slug differ. Engagement 2026-08-12.
const primaryRegionName = regionName(data.primary_region);
const suburb = data.location?.suburb;
const suburbIsRegion =
  !!suburb && suburb.trim().toLowerCase() === primaryRegionName.trim().toLowerCase();

const datelineParts = [
  suburbIsRegion ? undefined : suburb,
  STATE_NAMES[data.location?.state as keyof typeof STATE_NAMES],
  primaryRegionName,
].filter(Boolean);

const category = CATEGORY_LABELS[data.category as keyof typeof CATEGORY_LABELS];
const href = `/producer/${slug}/`;
---

<li class="entry">
  <article>
    <div class="entry__body">
      <h2 class="entry__name">
        <a href={href}>{data.name}</a>
      </h2>

      <p class="entry__dateline mono mono-caps">
        {datelineParts.join(" · ")}{category ? ` · ${category}` : ""}
      </p>

      <p class="entry__summary">{data.summary}</p>

      {/*
        SCHEMA.md §1.15, and the reason the state travels in `producers.json`
        at all. A region page that lists unconfirmed entries without saying so
        is the misrepresentation the state was added to avoid, so the notice
        rides the card and not only the entry page.

        One short mono line, appended to the dateline register rather than
        given a badge, a pill or a colour. It is a fact about the evidence, not
        a warning (DESIGN.md §2 on `--claret`).
      */}
      {
        data.ownership_status === "unconfirmed" && (
          <p class="entry__ownership mono mono-caps">Ownership not confirmed</p>
        )
      }

      <FactRow data={data} context="list_entry" compact />
    </div>

    {
      data.image && (
        <a href={href} class="entry__thumb" tabindex="-1" aria-hidden="true">
          <img
            src={data.image}
            alt=""
            loading="lazy"
            decoding="async"
            transition:name={`plate-${slug}`}
          />
        </a>
      )
    }
  </article>
</li>

<style>
  .entry {
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
  }

  .entry article {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .entry__body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .entry__name {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    margin-bottom: 0.4rem;
  }

  .entry__name a {
    text-decoration-color: transparent;
  }

  .entry__name a:hover,
  .entry__name a:focus-visible {
    text-decoration-color: var(--vine);
  }

  .entry__dateline {
    color: var(--ink-faded);
    margin: 0 0 0.6rem;
  }

  .entry__summary {
    font-style: italic;
    margin: 0 0 0.8rem;
    max-width: 60ch;
  }

  .entry__ownership {
    color: var(--ink-faded);
    margin: 0 0 0.6rem;
  }

  /* No mount, no shadow, no rotation, no radius. */
  .entry__thumb {
    flex: none;
    width: clamp(56px, 8vw, 72px);
    text-decoration: none;
  }

  .entry__thumb img {
    width: 100%;
    height: auto;
  }
</style>
