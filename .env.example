# =============================================================================
# Environment configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must never be committed, printed, or echoed into a log (CLAUDE.md rule 5).
#
# Parsed by the hand-rolled loader in `admin/config.py` (TRD.md §2.3). That
# parser is deliberately minimal: `KEY=VALUE`, one per line, `#` comments,
# blank lines ignored. It does NOT strip quotes, expand variables, or handle
# `export`. So write:
#     SITE_URL=https://example.com
# not:
#     export SITE_URL="https://example.com"
#
# `docker-entrypoint.sh` materialises this exact key set from Fly secrets at
# container boot. Adding a key here means adding it there too, or the admin
# app will silently fall back to a default in production.
# =============================================================================


# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------

# Without this, every pipeline stage fails immediately with a clear error.
# Nothing else in the admin app depends on it: the review queue, the deploy
# strip and the data layer all work without a key. Only harvesting stops.
ANTHROPIC_API_KEY=

# Model IDs, one per agent role.
#
# The pipeline reads these; models are NEVER hardcoded in source (TRD.md §2.2).
# Changing a model is a config change, not a code change.
#
# The role split is a cost decision, not an accident: extraction and checking
# are mechanical and go to a cheap fast model; drafting carries the register
# and goes to a strong one.
MODEL_HARVESTER=claude-haiku-4-5-20251001
MODEL_ARCHITECT=claude-opus-5
MODEL_GATEKEEPER=claude-haiku-4-5-20251001

# Editorial roles (Gate 11). Each cascades to a sensible default if unset, so
# overriding one variable never leaves another holding an invalid id:
#     MODEL_ARTICLE   falls back to MODEL_ARCHITECT
#     MODEL_BRIEF     falls back to MODEL_ARTICLE
#     MODEL_FACTCHECK falls back to MODEL_GATEKEEPER
#
# MODEL_FACTCHECK is deliberately a different model from MODEL_ARTICLE. A
# drafting model is a poor judge of its own confabulation, and the whole point
# of the fact-check stage is that it is adversarial. Setting them to the same
# id defeats the stage; the pipeline will warn if you do.
MODEL_ARTICLE=
MODEL_BRIEF=
MODEL_FACTCHECK=


# -----------------------------------------------------------------------------
# Admin app
# -----------------------------------------------------------------------------

# Port uvicorn binds. Defaults to 8787 if unset. Must match `fly.toml`'s
# internal_port in production, or Fly health checks fail and the machine
# restarts in a loop.
ADMIN_PORT=8787

# HTTP Basic Auth on every admin route. If either is blank, the admin app
# refuses to start rather than serving an unauthenticated publish button to
# the internet. This is a deliberate fail-closed: the admin app can write to
# `_published` and push to git.
ADMIN_USERNAME=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# The public apex URL, no trailing slash. Used for canonicals, sitemap entries,
# JSON-LD `url` fields and IndexNow submissions. Wrong here means wrong in
# every canonical tag on the site, which is the kind of error that takes weeks
# to notice and months to unwind.
SITE_URL=https://example.com

# NOTE: SITE_NAME and SITE_TAGLINE are NOT here. They live in
# `site/src/config.ts` as build-time constants, because the site is statically
# generated and the admin app has no use for them. Both are placeholders until
# the brand name is decided (TRD.md §1).


# -----------------------------------------------------------------------------
# Deploy — Netlify
# -----------------------------------------------------------------------------

# Both optional. Without them the deploy still works end to end: commit, push,
# and Netlify's own GitHub integration builds the site.
#
# What you lose without them:
#   - the post-push build poll, so the admin UI cannot tell you whether the
#     build succeeded; you find out by loading the site
#   - the IndexNow ping, which fires only on a confirmed-ready deploy — there
#     is no reliable live-yet signal to fire it from otherwise
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# IndexNow key. A 32-character hex string you choose, which must also exist as
# a static file at `site/public/<key>.txt` containing the key itself. Without
# it, search engines discover new producer pages on their own crawl schedule
# instead of within minutes. Nothing breaks; discovery is just slower.
INDEXNOW_KEY=


# -----------------------------------------------------------------------------
# Deploy — GitHub (Fly.io container only)
# -----------------------------------------------------------------------------

# A fine-grained personal access token with contents:write on this repo.
# Required ONLY in the Fly container, where `docker-entrypoint.sh` clones the
# repo onto the volume at boot and the admin app pushes publish commits.
#
# Leave blank for local development — a local checkout uses your own git
# credentials. The token is installed as a per-invocation credential helper
# and is never written to `.git/config` or any file on disk.
GITHUB_PAT=


# -----------------------------------------------------------------------------
# Geocoding
# -----------------------------------------------------------------------------

# Nominatim (OpenStreetMap), called over raw httpx. No API key exists or is
# needed. Results are cached to disk, so a given address is geocoded once.
GEOCODER=nominatim

# Nominatim's usage policy REQUIRES a User-Agent identifying the application
# and a contact address. Requests without one get blocked, and a blocked
# geocoder means every new producer publishes with null coordinates — which
# is allowed by the schema and easy to miss, so set this properly.
GEOCODER_USER_AGENT=winemakers-directory/1.0 (you@example.com)


# =============================================================================
# Deliberately absent
#
# These keys exist in the reference build and are NOT carried here. Each is an
# out-of-scope decision recorded in TRD.md §8, not an oversight. Do not add one
# back without the dated exception that scope change requires.
#
#   STRIPE_*                  no claim flow, no payments
#   SMTP_*, CLAIM_NOTIFY_*    no operator outreach, no notification pipeline
#   GOOGLE_PLACES_API_KEY     discovery deferred; a metered API that would
#                             surface, in rank order, exactly the corporate
#                             cellar doors the independence rule then rejects
#   GOATCOUNTER_SITE          no public analytics; no conversion to measure
# =============================================================================
